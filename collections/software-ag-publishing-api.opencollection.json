{
  "opencollection": "1.0.0",
  "info": {
    "name": "webMethods API Gateway Service Management APIs Publishing API",
    "version": "11.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Publishing",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Publish API to Portal",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "http://localhost:5555/rest/apigateway/apis/:apiId/publish",
            "params": [
              {
                "name": "apiId",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the API"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Register an API to the webMethods Developer Portal for consumer discovery."
        }
      ]
    }
  ],
  "bundled": true
}